    <!-- http://purl.obolibrary.org/obo/VT_0002436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005010"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of a CD8-positive, alpha-beta T cell capable of killing target cells in an antigen specific manner.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>CTL morphology trait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>cytotoxic T cell morphology trait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>cytotoxic T lymphocyte morphology trait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>cytotoxic T-cell morphology trait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>cytotoxic T-lymphocyte morphology trait</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta cytotoxic T lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta cytotoxic T-cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, alpha-beta cytotoxic T-lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002436</oboInOwl:id>
        <rdfs:comment>Note that while T cells of this subset are loosely referred to &apos;cytotoxic T cells,&apos; as many other T cell types, including CD4-positive, alpha-beta T cells and gamma-delta T cells exhibit cytotoxicity in vitro and in vivo.</rdfs:comment>
        <rdfs:label>CD8-positive, alpha-beta cytotoxic T cell morphology trait</rdfs:label>
    </owl:Class>
