    <!-- http://purl.obolibrary.org/obo/VT_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000001">
        <obo:IAO_0000115>Any measurable or observable characteristic of a vertebrate organism.</obo:IAO_0000115>
