    <!-- http://purl.obolibrary.org/obo/VT_0011290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0011290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0011288"/>
        <obo:IAO_0000115>The proportion, quantity, or volume of ribonucleic acid in  the unpaired midbrain region situated in the ventromedial portion of the reticular formation. The VTA is medial to the substantia nigra and ventral to the red nucleus, and extends caudally from the posterior hypothalamus in the diencephalon. The VTA contains dopamine neurons that project to various limbic and cortical areas and is a critical component of the brain&apos;s reward circuitry. Ribonucleic acid is a high molecular weight, linear polymer composed of nucleotides containing ribose and linked by phosphodiester bonds.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0002-2346-5201"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-14T19:59:57Z</terms:date>
        <oboInOwl:hasDbXref>CMO:0004142</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>VTA RNA amount</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>VTA ribonucleic acid amount</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral tegmental area RNA amount</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0011290</oboInOwl:id>
        <rdfs:label>ventral tegmental area ribonucleic acid amount</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0011290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The proportion, quantity, or volume of ribonucleic acid in  the unpaired midbrain region situated in the ventromedial portion of the reticular formation. The VTA is medial to the substantia nigra and ventral to the red nucleus, and extends caudally from the posterior hypothalamus in the diencephalon. The VTA contains dopamine neurons that project to various limbic and cortical areas and is a critical component of the brain&apos;s reward circuitry. Ribonucleic acid is a high molecular weight, linear polymer composed of nucleotides containing ribose and linked by phosphodiester bonds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CHEBI:33697</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>RGD:cur</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UBERON:0002691</oboInOwl:hasDbXref>
    </owl:Axiom>
    


