    <!-- http://purl.obolibrary.org/obo/VT_0000872 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000854"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the transient layer of the cerebellar cortex which is composed of the dividing and migrating granule cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EGL morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>External Germinal Layer morphology trait</oboInOwl:hasExactSynonym>
