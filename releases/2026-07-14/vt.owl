    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000889 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0004097"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the outermost layer of the cerebral cortex that contains the parallel fibers of the granule cells, interneurons such as stellate and basket cells, and the dendrites of the underlying Purkinje cells.</obo:IAO_0000115>
