        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002459"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the change in morphology and behavior of a mature or immature B cell during an immune response, resulting from exposure to a mitogen, cytokine, chemokine, cellular ligand, or an antigen for which it is specific.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0008217</oboInOwl:id>
        <rdfs:label>B cell activation trait</rdfs:label>
    </owl:Class>
