    <!-- http://purl.obolibrary.org/obo/VT_0004096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0003864"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the morphology or physiology during formation of the midbrain-hindbrain domain, comprised of the mesencephalic vesicle and the first rhombencephalic vesicle at early somitogenesis stages during its formation and differentiation; this area is an organizing center at the boundary patterns the midbrain and hindbrain primordia of the neural plate.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004096</oboInOwl:id>
        <rdfs:label>midbrain-hindbrain boundary development trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the morphology or physiology during formation of the midbrain-hindbrain domain, comprised of the mesencephalic vesicle and the first rhombencephalic vesicle at early somitogenesis stages during its formation and differentiation; this area is an organizing center at the boundary patterns the midbrain and hindbrain primordia of the neural plate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0004096</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0004097 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000849"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the thin mantle of gray matter that covers the surface of each cerebral hemisphere, including the six layers of nerve cells and the nerve pathways that connect them; together, these regions are responsible for the processes of conscious thought, perception, emotion and memory as well as advanced motor function.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0010291</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004097</oboInOwl:id>
        <rdfs:label>cerebellar cortex morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the thin mantle of gray matter that covers the surface of each cerebral hemisphere, including the six layers of nerve cells and the nerve pathways that connect them; together, these regions are responsible for the processes of conscious thought, perception, emotion and memory as well as advanced motor function.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0838580343</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0004097</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0004098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000886"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the small neurons of the granule cell layer that send parallel fibers to the upper molecular layer, where they synapse with Purkinje cell dendrites.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cerebellar granule neuron morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>granule cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004098</oboInOwl:id>
        <rdfs:label>cerebellar granule cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004098"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the small neurons of the granule cell layer that send parallel fibers to the upper molecular layer, where they synapse with Purkinje cell dendrites.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0838580343</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0004099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000886"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the intertwined cluster of nerve fibers surrounded by glia where mossy fibers from the pontine nuclei in the white matter synapse with granule cell axons, Golgi cell axons and unipolar brush interneuron axons.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004099</oboInOwl:id>
