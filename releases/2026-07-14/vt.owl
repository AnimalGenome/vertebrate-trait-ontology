        <oboInOwl:hasExactSynonym>spleen B-cell corona morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>splenic B cell corona morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002360</oboInOwl:id>
        <rdfs:label>spleen B cell corona morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the area of the spleen secondary B follicle that surrounds the germinal center and harbors the small recirculating B lymphocytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17495967</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002357"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0010929"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the blood vessel surrounded by the periarteriolar lymphoid sheath that connects the trabecular artery to the trabecular vein.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CA morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>follicular arteriole morphology trait</oboInOwl:hasExactSynonym>
