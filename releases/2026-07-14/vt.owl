    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000872"/>
        <obo:IAO_0000115>The distance between the surfaces of the transient layer of the cerebellar cortex which is composed of dividing and migrating granule cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EGL thickness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>External Germinal Layer thickness</oboInOwl:hasExactSynonym>
