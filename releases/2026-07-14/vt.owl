    <!-- http://purl.obolibrary.org/obo/VT_0000828 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000822"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000841"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the irregularly shaped cavity in the rhombencephalon, between the medulla oblongata, the pons, and the isthmus in front, and the cerebellum behind; it is continuous with the central canal of the cord below and with the cerebral aqueduct above, and through its lateral and median apertures it communicates with the subarachnoid space.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ventricle of rhombencephalon morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventriculus quartus morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000828</oboInOwl:id>
        <rdfs:label>fourth ventricle morphology trait</rdfs:label>
    </owl:Class>
