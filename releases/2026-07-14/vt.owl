        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002400"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the specialized cells that are committed to giving rise to cells with particular functions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0002400</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005460"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the formation of lymphocytes and plasma cells from lymphoid stem cells which develop from the pluripotent hematopoietic stem cells in the bone marrow; lymphoid stem cells differentiate into T-lymphocytes; B-lymphocytes; plasma cells; or NK cells (natural killer cells), depending on the organ or tissues to which they migrate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>lymphocyte differentiation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002401</oboInOwl:id>
        <rdfs:label>lymphopoiesis trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the formation of lymphocytes and plasma cells from lymphoid stem cells which develop from the pluripotent hematopoietic stem cells in the bone marrow; lymphoid stem cells differentiate into T-lymphocytes; B-lymphocytes; plasma cells; or NK cells (natural killer cells), depending on the organ or tissues to which they migrate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MeSH:D038041</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002403 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005022"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the cells in the B lymphocyte lineage that have undergone VDJ rearrangement of the immunoglobulin heavy chain and are in the process of V-J rearrangement of the light chain: these cells express mu heavy chain on the cell surface.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002403</oboInOwl:id>
        <rdfs:comment>These cells express the mu heavy chain in both the cytoplasm and on the cell surface; in addition to the mu heavy chain, other cell surface markers include CD45R, MHC class II, CD19, CD20, CD38, and CD40.</rdfs:comment>
        <rdfs:label>pre-B cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002403"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the cells in the B lymphocyte lineage that have undergone VDJ rearrangement of the immunoglobulin heavy chain and are in the process of V-J rearrangement of the light chain: these cells express mu heavy chain on the cell surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-8153-1691-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0002403</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008037"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the subset of T cells found in the thymus that express neither CD4 nor CD8.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CD4-CD8- T cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>double negative T cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>double-negative T-cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002407</oboInOwl:id>
        <rdfs:comment>These are precursors to mature T cells; normally, they do not circulate, but are found in the thymus and they have not undergone rearrangement of the alpha and beta T cell receptor genes.</rdfs:comment>
        <rdfs:label>double-negative T cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002407"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the subset of T cells found in the thymus that express neither CD4 nor CD8.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-8153-1691-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0002407</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008037"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the subset of T cells found in the thymus that express both CD4 and CD8.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CD4+CD8+ T cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>double positive T cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002408</oboInOwl:id>
        <rdfs:comment>These cells are precursors to mature T cells and are generally located in the thymus; during their development trait, the alpha and beta chains of the T cell receptor are rearranged and the TCR receptor can be expressed.</rdfs:comment>
        <rdfs:label>double-positive T cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the subset of T cells found in the thymus that express both CD4 and CD8.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-8153-1691-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0002408</oboInOwl:hasDbXref>
    </owl:Axiom>
    


