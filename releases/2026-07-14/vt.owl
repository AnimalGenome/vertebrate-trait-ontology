    <!-- http://purl.obolibrary.org/obo/VT_0002439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008171"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of a terminally differentiated, post-mitotic, short-lived cell of the B cell lineage devoted to producing large amounts of immunoglobulin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>plasmacyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002439</oboInOwl:id>
        <rdfs:comment>Plasma cells are terminally differentiated B cells and no longer respond to antigens or helper T cells. In addition, they no longer express surface Ig or surface MHC class II molecules, and they secrete antibody at high rates.</rdfs:comment>
        <rdfs:label>plasma cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002439"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of a terminally differentiated, post-mitotic, short-lived cell of the B cell lineage devoted to producing large amounts of immunoglobulin.</owl:annotatedTarget>
