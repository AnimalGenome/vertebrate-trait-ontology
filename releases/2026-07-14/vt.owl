        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the cells that give rise to most types of cells necessary for fetal development.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002399</oboInOwl:id>
        <rdfs:label>pluripotent precursor cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
