        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the process by which spleen cells undergo programmed cell death.</owl:annotatedTarget>
