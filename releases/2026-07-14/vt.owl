        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000875"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the structural soundness of the layer of large neuron cell bodies between the molecular and granular layers of the cerebellum.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000884</oboInOwl:id>
