    <!-- http://purl.obolibrary.org/obo/VT_0000823 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000787"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000822"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the cavity in each of the cerebral hemispheres derived from the cavity of the embryonic neural tube; they are separated from each other by the septum pellucidum, and each communicates with the third ventricle by the foramen of Monro, through which also the choroid plexuses of the lateral ventricles become continuous with that of the third ventricle.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000823</oboInOwl:id>
        <rdfs:label>lateral ventricle morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the cavity in each of the cerebral hemispheres derived from the cavity of the embryonic neural tube; they are separated from each other by the septum pellucidum, and each communicates with the third ventricle by the foramen of Monro, through which also the choroid plexuses of the lateral ventricles become continuous with that of the third ventricle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0000823</oboInOwl:hasDbXref>
    </owl:Axiom>
    


