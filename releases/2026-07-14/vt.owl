        <oboInOwl:id>VT:0000011</oboInOwl:id>
        <rdfs:label>cloaca septation extent</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000011"/>
