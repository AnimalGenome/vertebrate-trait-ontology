        <oboInOwl:created_by>caripark</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-08-07T10:01:10Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>EFO:0600001</oboInOwl:hasDbXref>
