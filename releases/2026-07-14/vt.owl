    <!-- http://purl.obolibrary.org/obo/VT_0000886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0004097"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the innermost cortical layer of the cerebellum; contains densely packed small neurons, mostly granule cells with some Golgi cells are found at the outer border.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>IGL morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>granule layer morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>internal granule layer morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
