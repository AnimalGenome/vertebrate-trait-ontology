    <!-- http://purl.obolibrary.org/obo/VT_0004387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002084"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color or pattern of the horseshoe-shaped thickening of the endoderm at the cranial (rostral) end of the primitive streak formed by the involution of Spemann&apos;s organizer cells which, together with the notochord, induces the formation of the neural plate from the overlying ectodermal cells and contributes mesodermal type cells to the surrounding tissue.</obo:IAO_0000115>
