    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0004268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0001286"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color or pattern of the narrow, proximal portion of the optic vesicle which connects the embryonic eye and forebrain.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004268</oboInOwl:id>
