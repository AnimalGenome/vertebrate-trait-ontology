    <!-- http://purl.obolibrary.org/obo/VT_0011228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0011228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002063"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the ability to recall experiences linked with strong emotions better than neutral experiences. This type of memory is influenced by brain regions like the amygdala and hippocampus and is less likely to be forgotten over time.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0002-2346-5201"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-09-09T16:37:57Z</terms:date>
        <oboInOwl:hasDbXref>CMO:0004109</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0011228</oboInOwl:id>
        <rdfs:label>emotional memory trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0011228"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the ability to recall experiences linked with strong emotions better than neutral experiences. This type of memory is influenced by brain regions like the amygdala and hippocampus and is less likely to be forgotten over time.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>RGD:cur</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://dictionary.apa.org/emotional-memory</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.sciencedirect.com/topics/neuroscience/emotional-memory</oboInOwl:hasDbXref>
    </owl:Axiom>
    


