        <oboInOwl:hasExactSynonym>caudatoputamen morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dorsal basal ganglia morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004102</oboInOwl:id>
