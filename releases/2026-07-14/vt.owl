        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002152"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the caudal region of the brain; includes cerebellum, pons and medulla oblongata.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
