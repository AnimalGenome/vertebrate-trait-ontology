        <oboInOwl:hasDbXref>MP:0002399</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002400 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002085"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the specialized cells that are committed to giving rise to cells with particular functions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002400</oboInOwl:id>
        <rdfs:label>multipotent stem cell morphology trait</rdfs:label>
    </owl:Class>
