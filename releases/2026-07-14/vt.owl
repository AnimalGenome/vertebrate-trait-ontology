        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the forebrain region that coordinates neuronal signaling involved in the perception of smell; it receives input from the sensory neurons and outputs to the olfactory cortex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0838580343</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000820 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002200"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the network formed by blood vessels and the tela choroidea which secretes CSF into the ventricular spaces.</obo:IAO_0000115>
