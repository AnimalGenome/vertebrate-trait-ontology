    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000818"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the almond-shaped body of basal nuclei anterior to the inferior horn of the lateral ventricle of the brain, within the temporal lobe; this area is involved in aggression and fear responses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MeSH:D000679</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000819 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005235"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the forebrain region that coordinates neuronal signaling involved in the perception of smell; it receives input from the sensory neurons and outputs to the olfactory cortex.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000819</oboInOwl:id>
