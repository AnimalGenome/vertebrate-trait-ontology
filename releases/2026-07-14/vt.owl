        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the blood vessel surrounded by the periarteriolar lymphoid sheath that connects the trabecular artery to the trabecular vein.</owl:annotatedTarget>
