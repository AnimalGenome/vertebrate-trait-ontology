    <!-- http://purl.obolibrary.org/obo/VT_0000834 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000830"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the anterior part of the diencephalon that lies between the thalamus, hypothalamus, and tegmentum of the mesencephalon, including subthalamic nucleus, zona incerta, the fields of Forel, and the nucleus of ansa lenticularis.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ventral thalamus morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000834</oboInOwl:id>
        <rdfs:label>subthalamus morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the anterior part of the diencephalon that lies between the thalamus, hypothalamus, and tegmentum of the mesencephalon, including subthalamic nucleus, zona incerta, the fields of Forel, and the nucleus of ansa lenticularis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0000834</oboInOwl:hasDbXref>
