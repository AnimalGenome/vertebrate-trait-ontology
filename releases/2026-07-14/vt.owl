    <!-- http://purl.obolibrary.org/obo/VT_0002257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002256"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the paired triangular cartilages located postlaterally at the level of the thyroid cartilage.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002257</oboInOwl:id>
        <rdfs:comment>the vocal cords are attached to the arytenoid cartilages; their movement facilitates the vibration of the vocal cords</rdfs:comment>
        <rdfs:label>arytenoid cartilage morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the paired triangular cartilages located postlaterally at the level of the thyroid cartilage.</owl:annotatedTarget>
