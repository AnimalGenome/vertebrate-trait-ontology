        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0001445"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure or pattern of the morphologically and biochemically distinct link types that extend between the stereocilia of vestibular hair bundles.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
