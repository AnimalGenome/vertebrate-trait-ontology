    <!-- http://purl.obolibrary.org/obo/VT_0008769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0008769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002376"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the function of or processes in the phagocytic dendritic cells that are morphologically similar to plasma cells, but do not express B lineage markers, and produce large amounts of alpha/beta interferons (IFN-/) in response to viral and bacterial stimuli; plasmacytoid dendritic cells are found in the thymic medulla and lymph node T cell areas and are responsible for immune tolerance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0008769</oboInOwl:id>
