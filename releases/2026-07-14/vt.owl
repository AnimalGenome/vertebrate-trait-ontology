        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0011269</oboInOwl:id>
        <rdfs:label>prefrontal cortex ribonucleic acid amount</rdfs:label>
    </owl:Class>
