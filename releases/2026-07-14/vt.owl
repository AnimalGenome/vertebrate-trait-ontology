    <!-- http://purl.obolibrary.org/obo/VT_0002356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000689"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the parenchymatous tissue network of the spleen that consists of loose plates or cords (sinuses) infiltrated with red blood cells where most of the blood filtration occurs and degenerate erythrocytes are removed from the circulation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>splenic red pulp morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002356</oboInOwl:id>
        <rdfs:label>spleen red pulp morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002356"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the parenchymatous tissue network of the spleen that consists of loose plates or cords (sinuses) infiltrated with red blood cells where most of the blood filtration occurs and degenerate erythrocytes are removed from the circulation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0002356</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000689"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the parenchymatous tissue of the spleen that surrounds splenic blood vessels, consists of compact masses of lymphatic cells and is where foreign material removed from the blood is used to initiate an immune reaction that results in the production of antibodies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>splenic white pulp morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002357</oboInOwl:id>
        <rdfs:comment>Note that there is no consensus in the literature about which compartments constitute the white pulp or the ramifications of the microvasculature. In addition, notable differences exist between humans and rodents. In this ontology, the marginal sinus and marginal zone have been included as part of the white pulp.</rdfs:comment>
        <rdfs:label>spleen white pulp morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the parenchymatous tissue of the spleen that surrounds splenic blood vessels, consists of compact masses of lymphatic cells and is where foreign material removed from the blood is used to initiate an immune reaction that results in the production of antibodies.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0002357</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002357"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the area of the spleen within the marginal sinus in which T cells surround the central arteriole.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PALS morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T cell domain of the splenic white pulp morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>periarteriolar sheath morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>splenic periarteriolar lymphoid sheath morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002358</oboInOwl:id>
        <rdfs:label>spleen periarteriolar lymphoid sheath morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the area of the spleen within the marginal sinus in which T cells surround the central arteriole.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-397-51047-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0-8153-1691-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0002358</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008472"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the area of the spleen secondary B follicle where rapid B-cell proliferation, somatic hypermutation, and selection for antigen binding occurs.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>spleen GC morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spleen follicle center morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spleen follicle centre morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>splenic germinal center morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002359</oboInOwl:id>
        <rdfs:comment>Germinal centers are often identified by the binding of peanut agglutinin (PNA).</rdfs:comment>
        <rdfs:label>spleen germinal center morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0002359"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the area of the spleen secondary B follicle where rapid B-cell proliferation, somatic hypermutation, and selection for antigen binding occurs.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17495967</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0002360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0002360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008472"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the area of the spleen secondary B follicle that surrounds the germinal center and harbors the small recirculating B lymphocytes.</obo:IAO_0000115>
