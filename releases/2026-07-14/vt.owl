        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005195"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color or pattern of the second cranial nerve which is responsible for conveying visual information from the retina to the brain; it extends from the retina to the optic chiasma where part of its fibers become the optic tract and cross to the opposite side and pass to the geniculate bodies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CN-II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0001330</oboInOwl:id>
        <rdfs:label>optic nerve morphology trait</rdfs:label>
    </owl:Class>
