        <oboInOwl:hasExactSynonym>paries vestibularis ductus cochlearis morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vestibular membrane morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0006021</oboInOwl:id>
        <rdfs:label>Reissner membrane morphology trait</rdfs:label>
    </owl:Class>
