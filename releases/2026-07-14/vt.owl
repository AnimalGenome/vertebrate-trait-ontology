    <!-- http://purl.obolibrary.org/obo/VT_0011220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0011220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0010191"/>
        <obo:IAO_0000115>The proportion or number of larger than normal cells which are unstained using routine blood count methodologies; large unstained cells (LUC) are larger than normal lymphocytes, and may be atypical lymphocytes, myeloperoxidase deficient cells or peroxidase negative blasts. Aberrations in the count of large unstained cells may be indicative of viral disease or leukemia.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0002-2346-5201"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-20T15:50:25Z</terms:date>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0011220</oboInOwl:id>
        <rdfs:label>large unstained cell quantity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0011220"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The proportion or number of larger than normal cells which are unstained using routine blood count methodologies; large unstained cells (LUC) are larger than normal lymphocytes, and may be atypical lymphocytes, myeloperoxidase deficient cells or peroxidase negative blasts. Aberrations in the count of large unstained cells may be indicative of viral disease or leukemia.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0012360</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0011221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0011221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005311"/>
        <obo:IAO_0000115>The proportion, quantity, or volume in whole blood, serum, or plasma of glutamic acid (2-aminopentanedioic acid), a non-essential alpha-amino used in the biosynthesis of proteins; its anion form, glutamate, is the major excitatory neurotransmitter in the mammalian central nervous system and also serves as the metabolic precursor of gamma-aminobutyric acid (GABA), an inhibitory neurotransmitter.</obo:IAO_0000115>
        <terms:contributor rdf:resource="http://orcid.org/0000-0002-2346-5201"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-20T15:59:08Z</terms:date>
        <oboInOwl:hasNarrowSynonym>blood glutamate amount</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0011221</oboInOwl:id>
        <rdfs:label>blood glutamic acid amount</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0011221"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The proportion, quantity, or volume in whole blood, serum, or plasma of glutamic acid (2-aminopentanedioic acid), a non-essential alpha-amino used in the biosynthesis of proteins; its anion form, glutamate, is the major excitatory neurotransmitter in the mammalian central nervous system and also serves as the metabolic precursor of gamma-aminobutyric acid (GABA), an inhibitory neurotransmitter.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0030735</oboInOwl:hasDbXref>
    </owl:Axiom>
    


