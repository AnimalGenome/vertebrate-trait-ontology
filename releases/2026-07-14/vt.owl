    <!-- http://purl.obolibrary.org/obo/VT_0004242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0005461"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of phagocytic dendritic cells that are morphologically similar to plasma cells, but do not express B lineage markers, and produce large amounts of alpha/beta interferons (IFN-/) in response to viral and bacterial stimuli; plasmacytoid dendritic cells are found in the thymic medulla and lymph node T cell areas and are responsible for immune tolerance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>DC2 cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T-associated plasma cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lymphoid dendritic cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pDC morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasmacytoid T cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>plasmacytoid monocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004242</oboInOwl:id>
        <rdfs:label>plasmacytoid dendritic cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004242"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of phagocytic dendritic cells that are morphologically similar to plasma cells, but do not express B lineage markers, and produce large amounts of alpha/beta interferons (IFN-/) in response to viral and bacterial stimuli; plasmacytoid dendritic cells are found in the thymic medulla and lymph node T cell areas and are responsible for immune tolerance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0004242</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0004243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0004220"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the ability of a motor neuron to form new neuritic processes (sprouts) that emerge from the nodes of Ranvier or terminal arborizations in response to nerve injury (such as denervation), application of nerve toxin, or muscle inactivity (usually due to disease).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>motor nerve collateral sprouting trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004243</oboInOwl:id>
        <rdfs:label>motor nerve terminal sprouting trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the ability of a motor neuron to form new neuritic processes (sprouts) that emerge from the nodes of Ranvier or terminal arborizations in response to nerve injury (such as denervation), application of nerve toxin, or muscle inactivity (usually due to disease).</owl:annotatedTarget>
