    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000843"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The proportion or number of neurons in the group of motor neurons in the hindbrain; receives fibers from the facial muscles, stapedus muscle and stylohyoid muscle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000913"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the bend in the developing neural tube that produces a thinning of the roof of the pons and medulla oblongata and defines the boundary between the metencephalon and medulla oblongata in the embryo.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000844</oboInOwl:id>
        <rdfs:label>pontine flexure morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the bend in the developing neural tube that produces a thinning of the roof of the pons and medulla oblongata and defines the boundary between the metencephalon and medulla oblongata in the embryo.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0000844</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000846 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000841"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the most caudal region of the brainstem that lies directly rostral to the spinal cord; includes regions responsible for autonomic functions such as digestion, breathing and control of heart rate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>myelencephalon morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
