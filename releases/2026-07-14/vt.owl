        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/vt/releases/2026-07-14/vt.owl"/>
        <dc:description>The Vertebrate Trait Ontology is a controlled vocabulary for the description of traits (measurable or observable characteristics) pertaining to the morphology, physiology, or development of vertebrate organisms.</dc:description>
