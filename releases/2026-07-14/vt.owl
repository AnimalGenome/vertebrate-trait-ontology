    <!-- http://purl.obolibrary.org/obo/VT_0000842 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000842">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000848"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the nucleus of neurons on the dorsal part of the lateral surface of the pons; it normally receives projection fibers from the cochlear nuclei and is prominently involved in spatial localization of sound.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000842</oboInOwl:id>
