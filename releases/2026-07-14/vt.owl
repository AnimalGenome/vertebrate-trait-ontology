        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002256"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the largest of the laryngeal cartilages.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0002260</oboInOwl:id>
        <rdfs:comment>the thyroid cartilage consists of two fused plates; their point of fusion is the &quot;Adam&apos;s apple&quot;</rdfs:comment>
