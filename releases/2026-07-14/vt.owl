    <!-- http://purl.obolibrary.org/obo/VT_0004940 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008171"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the subset of B cells found predominantly in the peritoneum, pleural cavities, and spleen, which are enriched for self-reactivity; B-1 B cells are thought to be the primary source of natural IgM immunoglobulin, that is, IgM produced in large quantities without prior antigenic stimulation and generally reactive against various microorganisms, as well as the source of T-independent IgA immunoglobulin in the mucosal areas.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>B-1 B lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B-1 B-cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B-1 B-lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B1 cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004940</oboInOwl:id>
        <rdfs:label>B-1 B cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004940"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the subset of B cells found predominantly in the peritoneum, pleural cavities, and spleen, which are enriched for self-reactivity; B-1 B cells are thought to be the primary source of natural IgM immunoglobulin, that is, IgM produced in large quantities without prior antigenic stimulation and generally reactive against various microorganisms, as well as the source of T-independent IgA immunoglobulin in the mucosal areas.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:0000819</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0004940</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:11861604</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0004941 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008037"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the specialized subpopulation of T cells that act to suppress activation of the immune system and thus maintain immune system homeostasis and prevent pathological self-reactivity; these may include T cells that express the CD8 transmembrane glycoprotein (CD8-positive T cells), those that express CD4 and CD25 (CD4-positive, CD25-positive regulatory T cells or Tregs) and other T cell types that have suppressor function.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>regulatory T lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>regulatory T-cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>suppressor T cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>suppressor T lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>suppressor T-cell morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>suppressor T-lymphocyte morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>Treg cell morphology trait</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004941</oboInOwl:id>
        <rdfs:label>regulatory T cell morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004941"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the specialized subpopulation of T cells that act to suppress activation of the immune system and thus maintain immune system homeostasis and prevent pathological self-reactivity; these may include T cells that express the CD8 transmembrane glycoprotein (CD8-positive T cells), those that express CD4 and CD25 (CD4-positive, CD25-positive regulatory T cells or Tregs) and other T cell types that have suppressor function.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>CL:0000815</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0004941</oboInOwl:hasDbXref>
    </owl:Axiom>
    


