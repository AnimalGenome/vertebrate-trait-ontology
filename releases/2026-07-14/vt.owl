    <!-- http://purl.obolibrary.org/obo/VT_0001700 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0001700">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0001695"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the axial rotation of the germ layers of the embryo during the primitive streak/early somite stage (Mus:E8.5-E9.5) such that the curvature of the entire trunk region is reversed and the neural ectoderm moves to the convex region and the midgut region becomes located in the concave region.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0001700</oboInOwl:id>
        <rdfs:label>embryo turning trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0001700"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the axial rotation of the germ layers of the embryo during the primitive streak/early somite stage (Mus:E8.5-E9.5) such that the curvature of the entire trunk region is reversed and the neural ectoderm moves to the convex region and the midgut region becomes located in the concave region.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-12-402035-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0001700</oboInOwl:hasDbXref>
    </owl:Axiom>
    


