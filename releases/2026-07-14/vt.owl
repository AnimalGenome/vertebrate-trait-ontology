        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of one or both of the two interlocking gyri of the hippocampus; a circonvolution of rhinencephalon, the grey substance of which is rich in big pyramidal neuronal cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ammon horn morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cornu Ammonis morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hippocampus proper morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000815</oboInOwl:id>
        <rdfs:label>Ammon gyrus morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of one or both of the two interlocking gyri of the hippocampus; a circonvolution of rhinencephalon, the grey substance of which is rich in big pyramidal neuronal cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000816 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000816">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0002622"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the mechanosensitive hair bundles which are composed of thick long microvilli (stereocilia) and are located at the apical end of cochlear inner and outer hair cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cochlear hair bundle morphology trait</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000816</oboInOwl:id>
        <rdfs:label>cochlear hair cell stereociliary bundle morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0000816"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the mechanosensitive hair bundles which are composed of thick long microvilli (stereocilia) and are located at the apical end of cochlear inner and outer hair cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0004521</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000818 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0004166"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the almond-shaped body of basal nuclei anterior to the inferior horn of the lateral ventricle of the brain, within the temporal lobe; this area is involved in aggression and fear responses.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0006934</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000818</oboInOwl:id>
