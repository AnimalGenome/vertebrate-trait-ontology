    <!-- http://purl.obolibrary.org/obo/VT_0004237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0004237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0004234"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the muscles descending from the sphenoid bone to the lower jaw including the internal, or medial, pterygoid muscle and external, or lateral, pterygoid muscle; action of the former is closing the jaws and that of the latter is opening the jaws, protruding the mandible, and moving the mandible from side to side.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0004237</oboInOwl:id>
        <rdfs:label>pterygoid muscle morphology trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0004237"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the muscles descending from the sphenoid bone to the lower jaw including the internal, or medial, pterygoid muscle and external, or lateral, pterygoid muscle; action of the former is closing the jaws and that of the latter is opening the jaws, protruding the mandible, and moving the mandible from side to side.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0004237</oboInOwl:hasDbXref>
    </owl:Axiom>
    


