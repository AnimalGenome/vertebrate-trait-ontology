    <!-- http://purl.obolibrary.org/obo/VT_0008671 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0008671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008568"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the controlled release of a cytokine synthesized by T-cells that produces proliferation, immunoglobulin isotype switching, and immunoglobulin production by immature B-cells, and appears to play a role in regulating inflammatory and immune responses.</obo:IAO_0000115>
