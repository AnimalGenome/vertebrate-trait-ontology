        <owl:annotatedTarget>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the innermost cortical layer of the cerebellum; contains densely packed small neurons, mostly granule cells with some Golgi cells are found at the outer border.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0-683-40008-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0838580343</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/VT_0000887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000886"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the structural soundness of the deepest of the three layers of the cerebellum that contains granule cells.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000887</oboInOwl:id>
