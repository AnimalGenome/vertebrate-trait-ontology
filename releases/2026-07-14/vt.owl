        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0010695"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The proportion, quantity, or volume of the peptide hormone produced mainly by P/D1 cells lining the fundus of the stomach and epsilon cells of the pancreas that stimulates hunger and serves as a potent stimulator of growth hormone from the anterior pituitary gland; in addition to stimulating appetite and growth, ghrelin also plays various roles in energy homeostasis, neuropathy, and in the cardiovascular and immune systems.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0011611</oboInOwl:hasDbXref>
    </owl:Axiom>
    


