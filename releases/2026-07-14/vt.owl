    <!-- http://purl.obolibrary.org/obo/VT_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000628"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the increase in size of the milk-producing glands in female mammals, consisting of lobes containing clusters of alveoli with a system of ducts to convey the milk to an external nipple or teat.</obo:IAO_0000115>
