    <!-- http://purl.obolibrary.org/obo/VT_0000848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0000848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0000841"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of the band of nerve fibers in the brain connecting the medulla oblongata and the mesencephalon; this region conveys information about movement from the cerebral hemisphere to the cerebellum.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0000848</oboInOwl:id>
