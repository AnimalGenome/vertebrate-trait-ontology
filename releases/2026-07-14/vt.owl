    <!-- http://purl.obolibrary.org/obo/VT_0008662 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0008662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008568"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the controlled release of a heterodimeric cytokine that plays a role in innate and adaptive immune responses; it is produced by dendritic cells, macrophages and a variety of other immune cells and plays a role in the stimulation of interferon-gamma production by T-cells and natural killer cells.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>IL-12 p70 secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IL-12 secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IL12 secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cytotoxic lymphocyte maturation factor secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interleukin-12 p70 secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>natural killer cell stimulatory factor secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0008662</oboInOwl:id>
        <rdfs:comment>Interleukin-12 is a 70 kDa protein that is composed of covalently linked 40 kDa (IL-12b) and 35 kDa (IL-12a) subunits. The 40 kDa subunit (IL-12b) also is a component of interleukin-23 together with the IL-23a ( 19kDa) chain.</rdfs:comment>
        <rdfs:label>interleukin-12 secretion trait</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/VT_0008662"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any measurable or observable characteristic related to the controlled release of a heterodimeric cytokine that plays a role in innate and adaptive immune responses; it is produced by dendritic cells, macrophages and a variety of other immune cells and plays a role in the stimulation of interferon-gamma production by T-cells and natural killer cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MeSH:D018664</oboInOwl:hasDbXref>
    </owl:Axiom>
    


