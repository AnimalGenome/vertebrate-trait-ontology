        <oboInOwl:hasOBONamespace>Trait.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>VT:0009543</oboInOwl:id>
        <rdfs:label>thymus corticomedullary boundary morphology trait</rdfs:label>
    </owl:Class>
