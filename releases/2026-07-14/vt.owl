    <!-- http://purl.obolibrary.org/obo/VT_0009920 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VT_0009920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/VT_0008188"/>
        <obo:IAO_0000115>Any measurable or observable characteristic related to the shape, structure, color, or pattern of a type of transitional stage B cell that has the phenotype surface IgM-positive, surface IgD-positive, CD21-positive, CD23-positive, CD62L-negative, and is located in the splenic B follicles.</obo:IAO_0000115>
